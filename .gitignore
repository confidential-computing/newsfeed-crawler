webfeed/
webfeed-*.md
rf-webfeed-*.md
webfeed-cron.log

# Separate clone of the published newsfeed repository
newsfeed/

# Saved feed entries (crawler.py --store-only) and its run log
feed-store/

# English translations of non-English titles (claude CLI), rebuilt on demand
translations.json
.webfeed.lock
